# Environment Configuration for Open Resume Builder
# Copy this file to .env.local for development or .env for production
# 
# Required: MariaDB/MySQL connection string
# Get from your MariaDB setup: mysql://username:password@host:port/database
DATABASE_URL="mysql://root:password@localhost:3306/open_resume"

# Optional: OpenAI API Key for AI chat/assistant features
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Optional: Application URL (used in metadata and OAuth)
NEXT_PUBLIC_APP_URL="http://localhost:3033"

# Optional: Enable/disable logging
LOG_LEVEL="info"

# Prisma settings
PRISMA_CLIENT_ENGINE_TYPE="binary"
